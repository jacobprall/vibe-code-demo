# The one repository generated apps are committed to. Every run adds
# apps/<user>/<app>/ and updates the Blueprint at its root.
APPS_REPO=owner/generated-apps

# Shared by both processes.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/vibe_factory
# The gateway uses this to dispatch tasks; the workflows host to run sandboxes,
# read Render state, connect the agents to the Render MCP server, and delete
# the services, databases, and project of a deleted app.
RENDER_API_KEY=

# Gateway. The bearer token callers present to POST /v1/apps. The production
# Blueprint generates it automatically; for local development, use:
# openssl rand -hex 32
FACTORY_API_KEY=
# The Workflows service slug, without a task name. render.yaml sets it on the
# deployed gateway. Locally, `npm run dev:gateway` sets
# RENDER_USE_LOCAL_DEV=true, so tasks start on the `npm run dev:workflows` task
# server. That server finds a task by its name only, so this default value
# works. Do not set RENDER_USE_LOCAL_DEV in this file: the workflows host also
# loads it, and the local task server has no Sandboxes API.
RENDER_WORKFLOW_SLUG=vibe-factory-workflows
# Protects the browser UI and its server-side submission endpoints.
UI_USERNAME=demo
UI_PASSWORD=
# Local development only. Ignored when NODE_ENV=production.
UI_AUTH_DISABLED=false

# Optional CLI demo settings.
FACTORY_GATEWAY_URL=http://localhost:3000
FACTORY_USER=demo

# Workflows host.
ANTHROPIC_API_KEY=
RENDER_WORKSPACE_ID=

# Optional. Defaults to https://mcp.render.com/mcp.
RENDER_MCP_URL=

# GitHub credentials — pick one. Both need Contents: write on APPS_REPO.
#
# A) GitHub App. Commits are attributed to the app, and installation tokens
#    expire hourly. The private key may be raw PEM, PEM with escaped
#    newlines, or base64-encoded.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
#
# B) Fine-grained PAT. Faster to set up.
GITHUB_TOKEN=
